# Local development runs against the testing environment (API and Keycloak),
# so that editing can be tried out without touching production data
VITE_APP_KEYCLOAK_URL=https://auth.opendatahub.testingmachine.eu/auth
VITE_APP_KEYCLOAK_REALM=noi
VITE_APP_KEYCLOAK_CLIENT_ID=it.bz.opendatahub.databrowser
VITE_APP_KEYCLOAK_REDIRECT_URI=http://localhost:3000/silent-check-sso.html
VITE_APP_IMAGE_UPLOAD_URL=https://tourism.api.opendatahub.testingmachine.eu/v1/FileUpload/Image
VITE_APP_FILE_UPLOAD_URL=https://tourism.api.opendatahub.testingmachine.eu/v1/FileUpload
VITE_APP_ODH_LOOKUP_BASE_URL=https://tourism.api.opendatahub.testingmachine.eu
VITE_APP_ENV_BADGE=TESTING
VITE_APP_META_ROBOTS=
VITE_APP_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_APP_CANONICAL_ORIGIN=https://databrowser.opendatahub.com
